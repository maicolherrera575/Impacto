# Copia este archivo como ".env" y completa los valores reales.
# Nunca subas el archivo .env a un repositorio público.

# Proyecto Supabase (URL pública del proyecto)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Llave pública (anon / publishable) de Supabase — protegida por RLS
VITE_SUPABASE_ANON_KEY="tu-supabase-anon-key"

# Llave de Google AI Studio (Gemini) — SOLO para desarrollo local (npm run dev).
# En producción (Vercel) NO la pongas como VITE_*: configúrala en Vercel como
# GEMINI_API_KEY (variable privada, sin VITE_) y la app usará /api/gemini.
VITE_GEMINI_API_KEY="tu-gemini-api-key"

# WhatsApp del administrador (recarga de créditos, soporte). Formato internacional sin "+".
VITE_ADMIN_WHATSAPP="573000000000"

# ═══════════ SOLO EN VERCEL (Settings → Environment Variables) ═══════════
# GEMINI_API_KEY="tu-gemini-api-key"   ← privada: la IA nunca se expone al navegador
